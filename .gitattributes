# Normalize line endings: LF in the repository for all text files.
* text=auto

# Source and config files: LF everywhere (repo and working tree)
*.py text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.toml text eol=lf
*.md text eol=lf
*.xml text eol=lf
*.json text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.stl binary
*.step binary
*.3mf binary
*.pickle binary
*.pkl binary
*.zip binary
*.pt binary
*.pyd binary
*.mp4 binary
